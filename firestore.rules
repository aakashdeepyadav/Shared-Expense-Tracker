rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function groupAppConfigExists(groupId) {
    function groupAppConfigExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/config/app);

    // Setup is unauthenticated. Allow creating a group's initial docs only
    // Setup runs before Firebase auth. Allow creating initial group docs only
    // while that group's app config does not exist yet.
    function canBootstrapGroupSetup(groupId) {
      return !groupAppConfigExists(groupId);

    match /groups/{groupId} {
    match /groups/{groupId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/groups/$(groupId));
      allow update: if isSignedIn();
      allow delete: if false;

      match /config/app {
        allow create: if canBootstrapGroupSetup(groupId);
        allow read: if true;
        allow update: if isSignedIn();
        allow delete: if false;
      }

      match /config/admin {
        allow create: if canBootstrapGroupSetup(groupId);
        allow read: if true;
        allow update: if isSignedIn();
        allow delete: if false;
      }

      match /users/{userId} {
        allow create: if canBootstrapGroupSetup(groupId);
        allow read, update: if true;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, write: if isSignedIn();
      }

      match /contributions/{contributionId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /auditLogs/{entryId} {
        allow read, write: if isSignedIn();
      }

      match /monthArchives/{archiveId} {
        allow read, write: if isSignedIn();
      }
        allow read, write: if isSignedIn();
      }

      match /monthArchives/{archiveId} {
        allow read, write: if isSignedIn();
      }
    }

    // Block everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}