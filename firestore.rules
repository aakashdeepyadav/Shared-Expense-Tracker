rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidGroupId(groupId) {
      return groupId.matches('^[a-z0-9-]{3,30}$');
    }

    function groupAppConfigExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/config/app);
    }

    function canBootstrapGroupSetup(groupId) {
      return isValidGroupId(groupId) && !groupAppConfigExists(groupId);
    }

    function canAccessInitializedGroup(groupId) {
      return isValidGroupId(groupId) && groupAppConfigExists(groupId);
    }

    function validPhoneOrNull(phone) {
      return phone == null || phone.matches('^\\+91[6-9][0-9]{9}$');
    }

    function validCredentialString(value, minLen) {
      return value is string && value.size() >= minLen && value.size() <= 128;
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if canBootstrapGroupSetup(groupId);
      allow update: if canAccessInitializedGroup(groupId);
      allow delete: if false;

      match /config/app {
        allow create: if canBootstrapGroupSetup(groupId)
          && request.resource.data.initialized == true;
        allow read: if true;
        allow update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }

      match /config/admin {
        allow create: if canBootstrapGroupSetup(groupId)
          && validCredentialString(request.resource.data.password, 8)
          && validCredentialString(request.resource.data.pin, 6);
        allow read: if true;
        allow update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }

      match /users/{userId} {
        allow create: if canBootstrapGroupSetup(groupId) || canAccessInitializedGroup(groupId);
        allow read: if true;
        allow update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if canAccessInitializedGroup(groupId);
        allow create, update: if canAccessInitializedGroup(groupId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000;
        allow delete: if false;
      }

      match /contributions/{contributionId} {
        allow read: if canAccessInitializedGroup(groupId);
        allow create, update: if canAccessInitializedGroup(groupId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if canAccessInitializedGroup(groupId);
        allow create, update: if canAccessInitializedGroup(groupId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow delete: if false;
      }

      match /auditLogs/{entryId} {
        allow read: if canAccessInitializedGroup(groupId);
        allow create, update: if canAccessInitializedGroup(groupId)
          && request.resource.data.action is string
          && request.resource.data.action.size() > 0
          && request.resource.data.action.size() <= 120;
        allow delete: if false;
      }

      match /monthArchives/{archiveId} {
        allow read: if canAccessInitializedGroup(groupId);
        allow create, update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
