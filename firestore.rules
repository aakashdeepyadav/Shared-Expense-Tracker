rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function groupAppConfigExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/config/app);
    }

    // Setup runs before Firebase auth; allow initial create only once.
    function canBootstrapGroupSetup(groupId) {
      return !groupAppConfigExists(groupId);
    }

    // App uses local role/password/PIN login, so group writes are allowed
    // after setup has initialized the group config.
    function canAccessInitializedGroup(groupId) {
      return groupAppConfigExists(groupId);
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/groups/$(groupId));
      allow update: if canAccessInitializedGroup(groupId);
      allow delete: if false;

      match /config/app {
        allow create: if canBootstrapGroupSetup(groupId);
        allow read: if true;
        allow update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }

      match /config/admin {
        allow create: if canBootstrapGroupSetup(groupId);
        allow read: if true;
        allow update: if canAccessInitializedGroup(groupId);
        allow delete: if false;
      }

      match /users/{userId} {
        allow create: if canBootstrapGroupSetup(groupId) || canAccessInitializedGroup(groupId);
        allow read, update: if true;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, write: if canAccessInitializedGroup(groupId);
      }

      match /contributions/{contributionId} {
        allow read, write: if canAccessInitializedGroup(groupId);
      }

      match /messages/{messageId} {
        allow read, write: if canAccessInitializedGroup(groupId);
      }

      match /auditLogs/{entryId} {
        allow read, write: if canAccessInitializedGroup(groupId);
      }

      match /monthArchives/{archiveId} {
        allow read, write: if canAccessInitializedGroup(groupId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
